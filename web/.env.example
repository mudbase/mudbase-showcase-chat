# ---------------------------------------------------------------------------
# Mudbase project (public - a project id is not a secret) ---------------------
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MUDBASE_PROJECT_ID=
NEXT_PUBLIC_MUDBASE_URL=https://cloud.mudbase.dev

# The application role new sign-ups are created under. Every project ships a
# default "user" role; some projects use a custom app role (the ecommerce /
# social showcases use "customer"). Set this to whichever role your project
# exposes at POST /api/auth/local/signup/{role}.
NEXT_PUBLIC_MUDBASE_APP_ROLE=user

# ---------------------------------------------------------------------------
# Chat authorization key -----------------------------------------------------
# ---------------------------------------------------------------------------
# The chat write endpoints (create chat, send message, react, mark read) are
# authorized against a project key scoped to the "messaging" capability, sent
# alongside each end-user's own session token. The key never replaces the user
# identity - the request carries BOTH the signed-in user's token (who is acting)
# and this key (that the action is permitted). Issue a project key with the
# messaging capability from your Mudbase project settings and paste it here.
#
# Reading chats/messages and establishing a session work without this key; only
# the write paths require it. Leave it empty to run the app in read-only mode.
NEXT_PUBLIC_MUDBASE_MESSAGING_KEY=

# Optional: a project key scoped to the "storage" capability, used the same way
# for uploading media attachments to a bucket. Without it, attachments can still
# be shared by pasting a link; native upload stays disabled and the composer
# says so rather than pretending to upload.
NEXT_PUBLIC_MUDBASE_STORAGE_KEY=
NEXT_PUBLIC_MUDBASE_STORAGE_BUCKET=
